<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 插件 / 更新清单下载 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- App 自身增量更新：vcdiff 合成新 APK 后拉起系统安装器（Android 8+ 需要） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ 包可见性：用户用系统安装器 sideload 的插件 APK（plugin-*.apk）
         必须在此声明包名，宿主的 adoptSystemInstalledPlugins() 才能扫到并导入注册表；
         否则 getInstalledPackages() 被系统过滤，装完仍显示「未安装」。 -->
    <queries>
        <package android:name="com.ultraguru.liquidglass.plugin.kyant0" />
        <package android:name="com.ultraguru.liquidglass.plugin.cloudy" />
        <package android:name="com.ultraguru.liquidglass.plugin.qmdeve" />
        <package android:name="com.ultraguru.liquidglass.plugin.qwea0" />
        <package android:name="com.ultraguru.liquidglass.plugin.nadeem" />
    </queries>

    <application
        android:name=".GlassLabApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlassLab">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:exported="true"
            android:theme="@style/Theme.GlassLab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 合成后的新 APK 交给系统安装器（FileProvider 内容 URI） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
